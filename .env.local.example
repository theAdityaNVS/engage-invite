# Copy this file to .env.local and fill in your API keys
# .env.local is gitignored and should never be committed

# OpenWeatherMap API key (sign up free at https://openweathermap.org/api)
# Server-side only — key is proxied via /api/weather, never sent to the browser
WEATHER_API_KEY=

# --- Visit analytics ---
# Neon Postgres pooled connection string (server-side only). Get it from the
# Neon console for the 'adityanvs-invites' project, or `neon connection-string`.
DATABASE_URL=

# Basic Auth credentials for the /admin/visits dashboard and /api/visits API.
# Use a strong password; this is the only thing protecting raw visitor IPs.
ADMIN_USER=
ADMIN_PASS=
